{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Electronic product sold in the shop",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "integer" },
        "specs": { "type": "object" },
        "isFeatured": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSelling": { "type": "boolean" },
        "stars": { "type": "number" }
      },
      "required": ["name", "price", "category", "images"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "guestEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "deposit": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "partially_paid", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "trackingId": { "type": "string" },
        "invoiceUrl": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "items", "total"]
    },
    "User": {
      "title": "User",
      "description": "Shop user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] }
      }
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Available products for sale"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "users": {
      "schema": "User",
      "description": "Customer and admin profiles"
    }
  }
}
